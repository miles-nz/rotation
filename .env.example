SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: Last.fm read-only API access (scrobble counts, etc). Free for
# personal/non-commercial use - get a key at last.fm/api/account/create.
# Leave blank to skip Last.fm features entirely. Once set, verify with:
#   python -c "from lastfm.lastfm_client import get_user_info; print(get_user_info())"
LASTFM_API_KEY=
LASTFM_USERNAME=
# Shared secret from the same API account. Not used by anything yet - only
# needed later for authenticated/write calls like scrobbling - but stored
# here now since Last.fm doesn't always show it again after creation.
LASTFM_SHARED_SECRET=

# Optional: hardcode default playlist selections for the tools so
# they're pre-selected automatically instead of picked each session.
# Only applied when the logged-in Spotify user matches SPOTIFY_OWNER_ID
# (find yours by logging in once, then running:
#   python -c "from spotify.spotify_client import get_authenticated_client; print(get_authenticated_client().current_user()['id'])"
# ). Leave all of these blank to skip hardcoded defaults entirely - every
# tool falls back to its normal empty picker.
SPOTIFY_OWNER_ID=

# Example: {"id1":"PLAYLIST_ID_A","name1":"Playlist A","id2":"PLAYLIST_ID_B","name2":"Playlist B"}
DEFAULT_LIKED_SONGS_SYNC=

# Example: [{"id":"PLAYLIST_ID_A","name":"Playlist A"},{"id":"PLAYLIST_ID_B","name":"Playlist B"}]
DEFAULT_DUPLICATES=

# Example: {"sources":[{"id":"PLAYLIST_ID_A","name":"Playlist A"}],"criteria":[{"field":"release_year","operator":"is","value":"2026","value2":null}],"destMode":"existing","destPlaylistId":"PLAYLIST_ID_DEST","destPlaylistName":"Dest Playlist","destNewName":null}
DEFAULT_PLAYLIST_FILTER=

# Example: {"playlistId":"PLAYLIST_ID_A","playlistName":"Playlist A","field":"added_date","operator":"older_than","value":"4","value2":"weeks"}
DEFAULT_PLAYLIST_CLEANUP=

# Example: {"sources":[{"id":"PLAYLIST_ID_A","name":"Playlist A"}],"targets":[{"id":"PLAYLIST_ID_B","name":"Playlist B"}]}
DEFAULT_PLAYLIST_DIFF=

# Example: {"sourceId":"PLAYLIST_ID_A","sourceName":"Playlist A","destinationId":"PLAYLIST_ID_B","destinationName":"Playlist B"}
DEFAULT_PLAYLIST_PREPEND=

# Array of step types to pre-populate the Cascade builder with, in order.
# Each step's actual settings (playlists, criteria, destination, ...) are
# pulled from that tool's own DEFAULT_* var above - nothing is repeated here,
# so there's one place to update each playlist selection.
# Valid types: "duplicates", "playlist_filter", "playlist_cleanup",
# "playlist_diff", "sync" (uses DEFAULT_LIKED_SONGS_SYNC). A step is skipped
# if its DEFAULT_* var is blank.
# Example: ["playlist_diff","duplicates","sync"]
DEFAULT_CASCADE=

# Optional: run the Cascade's default steps (DEFAULT_CASCADE above)
# automatically once a day as a read-only scan - it never applies changes,
# only notifies you if there's something to review. Requires SPOTIFY_OWNER_ID
# and DEFAULT_CASCADE (plus each included step type's own DEFAULT_* var) to
# be set above; the scheduler silently no-ops otherwise.
CASCADE_AUTO_ENABLED=

# Hour (0-23, UTC) the daily auto-scan runs at every day. Defaults to 8
# (8am UTC). Ignored if CASCADE_AUTO_SCHEDULE (below) is set.
CASCADE_AUTO_HOUR=8

# Optional: run on specific days at specific times instead of every day at
# CASCADE_AUTO_HOUR - a JSON object of {"day": hour_utc}. Days not listed
# are skipped entirely. Takes priority over CASCADE_AUTO_HOUR when set.
# Example: {"mon":9,"wed":14,"fri":18} runs Monday 9am, Wednesday 2pm, and
# Friday 6pm UTC, and never runs Tue/Thu/Sat/Sun.
CASCADE_AUTO_SCHEDULE=

# Discord or Slack incoming webhook URL, posted to when the auto-scan finds
# something to review (or when it can't run because your Spotify login
# expired). A URL containing "discord.com" gets a Discord-style
# {"content": ...} payload, anything else gets a Slack-style {"text": ...}
# payload. Leave blank to disable notifications - the home page's "pending
# review" banner still appears either way. The notification includes a link
# back to the app, built from SPOTIFY_REDIRECT_URI above (so it points at
# 127.0.0.1 locally or your real domain in production automatically).
CASCADE_WEBHOOK_URL=
