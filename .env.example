SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: hardcode default playlist selections for the tools so
# they're pre-selected automatically instead of picked each session.
# Only applied when the logged-in Spotify user matches SPOTIFY_OWNER_ID
# (find yours by logging in once, then running:
#   python -c "from spotify.spotify_client import get_authenticated_client; print(get_authenticated_client().current_user()['id'])"
# ). Leave all of these blank to skip hardcoded defaults entirely - every
# tool falls back to its normal empty picker.
SPOTIFY_OWNER_ID=

# Example: {"id1":"PLAYLIST_ID_A","name1":"Playlist A","id2":"PLAYLIST_ID_B","name2":"Playlist B"}
DEFAULT_LIKED_SONGS_SYNC=

# Example: [{"id":"PLAYLIST_ID_A","name":"Playlist A"},{"id":"PLAYLIST_ID_B","name":"Playlist B"}]
DEFAULT_DUPLICATES=

# Example: {"sources":[{"id":"PLAYLIST_ID_A","name":"Playlist A"}],"criteria":[{"field":"release_year","operator":"is","value":"2026","value2":null}],"destMode":"existing","destPlaylistId":"PLAYLIST_ID_DEST","destPlaylistName":"Dest Playlist","destNewName":null}
DEFAULT_PLAYLIST_FILTER=

# Example: {"playlistId":"PLAYLIST_ID_A","playlistName":"Playlist A","field":"added_date","operator":"older_than","value":"4","value2":"weeks"}
DEFAULT_PLAYLIST_CLEANUP=

# Example: {"sources":[{"id":"PLAYLIST_ID_A","name":"Playlist A"}],"targets":[{"id":"PLAYLIST_ID_B","name":"Playlist B"}]}
DEFAULT_PLAYLIST_DIFF=

# Example: {"sourceId":"PLAYLIST_ID_A","sourceName":"Playlist A","destinationId":"PLAYLIST_ID_B","destinationName":"Playlist B"}
DEFAULT_PLAYLIST_PREPEND=

# Array of step types to pre-populate the Cascade builder with, in order.
# Each step's actual settings (playlists, criteria, destination, ...) are
# pulled from that tool's own DEFAULT_* var above - nothing is repeated here,
# so there's one place to update each playlist selection.
# Valid types: "duplicates", "playlist_filter", "playlist_cleanup",
# "playlist_diff", "sync" (uses DEFAULT_LIKED_SONGS_SYNC). A step is skipped
# if its DEFAULT_* var is blank.
# Example: ["playlist_diff","duplicates","sync"]
DEFAULT_CASCADE=
